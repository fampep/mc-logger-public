# server-seeker — auto IP (masscan) + domain scan → Postgres → Discord bridge
# Copy to .env and edit before running.

SEEKER_DATABASE_URL=postgres://user:pass@localhost:5432/constantiam
SEEKER_MODE=watch
SEEKER_WATCH_INTERVAL=3600
SEEKER_I_UNDERSTAND=true

# IP discovery (masscan)
SEEKER_MASSCAN_CONFIG=masscan.conf
SEEKER_MASSCAN_SUDO=true

# Domain discovery (comma-separated; SEEKER_DOMAINS is an alias)
SEEKER_SEEDS=purityvanilla.com,play.vanillaplus.net
SEEKER_QUERIES=vanillaplus,vanilla plus

# Status ping tuning
SEEKER_PORT=25565
SEEKER_CONCURRENCY=64
SEEKER_RATE=200
SEEKER_TIMEOUT_MS=4000

# Optional small CIDR pass each watch cycle
# SEEKER_CIDRS=10.0.0.0/28

# Rescan known DB servers each cycle
# SEEKER_RESCAN_LIMIT=5000
# SEEKER_RESCAN_PRIORITY=oldest
