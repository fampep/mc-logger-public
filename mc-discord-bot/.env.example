# Template only — copy to .env and fill in. Never put real secrets in this file:
# .env is gitignored, .env.example is meant to be committed.

# ---- Database ----
# Multi-server setup (recommended when each logger has its own database):
# SERVERS=twobtwot,sixbsixt,vanillaplus,refinedvanilla,cutesmp
# SERVER_TWOBTWOT_URL=postgres://user:pass@localhost:5432/twobtwot
# SERVER_TWOBTWOT_LABEL=2b2t
# SERVER_SIXBSIXT_URL=postgres://user:pass@localhost:5432/sixbsixt
# SERVER_SIXBSIXT_LABEL=6b6t
# SERVER_VANILLAPLUS_URL=postgres://user:pass@localhost:5432/vanillaplus
# SERVER_VANILLAPLUS_LABEL=VanillaPlus
# SERVER_REFINEDVANILLA_URL=postgres://user:pass@localhost:5432/refinedvanilla
# SERVER_REFINEDVANILLA_LABEL=RefinedVanilla
# SERVER_CUTESMP_URL=postgres://user:pass@localhost:5432/cutesmp
# SERVER_CUTESMP_LABEL=CuteSMP
#
# Single-database fallback (omit SERVERS):
DATABASE_URL=postgres://constantiam:constantiam@localhost:5432/constantiam

# ---- Discord ----
# Developer Portal -> your app -> Bot -> Reset Token. Treat like a password.
# Also used by `cargo run --release --bin discord-scrape -- --channel CHANNEL_ID`
# (HTTP export only; does not open a second gateway login). Optional CHANNEL_ID=
# here, or pass --channel. Never put a user token in this file.
DISCORD_TOKEN=
# CHANNEL_ID=
# Developer Portal -> General Information -> Application ID (not a secret).
DISCORD_CLIENT_ID=
# Right-click your server -> Copy Server ID (needs Developer Mode enabled).
# Commands register instantly with this set; without it they are global and can
# take up to an hour to appear.
DISCORD_GUILD_ID=

# ---- Bridge ----
# Optional. The channel is normally chosen in Discord with `/chatbridge set`,
# which stores it in the database; this is only the initial default.
BRIDGE_CHANNEL_ID=
# Which kinds get forwarded: chat, join, leave, death, advancement, server, whisper
BRIDGE_KINDS=chat,join,leave,death,advancement,server
BRIDGE_POLL_MS=3000
# Feed style (rich/compact) and rainbow mode are per-server settings stored in
# the database now — set them live with `/chatbridge customize`, no restart
# needed. Every server starts on Rich until changed there.
# compact: lines per embed. rich: embeds per message (Discord's own cap is 10).
BRIDGE_LINES_PER_MESSAGE=20
BRIDGE_EMBEDS_PER_MESSAGE=10
# Cap per poll, so a backlog after downtime does not flood the channel.
BRIDGE_MAX_ROWS_PER_POLL=40
# false replays the whole backlog on first run; true starts from the newest row.
BRIDGE_START_FROM_LATEST=true

# ---- Live event streams (optional; replaces DB poll for the feed) ----
# Shared gateway for every SERVERS= key. The logger pushes; this bot
# subscribes with that key. Slash commands still use Postgres.
# EVENT_STREAM_ADDR=127.0.0.1:9700
# Optional per-server override:
# SERVER_REFINEDVANILLA_STREAM=127.0.0.1:9701

# ---- Channel topic ----
# Rewrites each feed channel's topic with that server's live numbers: players
# online, peak today, players in 24h, joins and chat per hour. Needs the Manage
# Channel permission there.
TOPIC_UPDATES=true
# Discord allows two channel edits per ten minutes, so this cannot be fast.
# Minimum 300000 (5 minutes).
TOPIC_INTERVAL_MS=600000

# ---- Appearance ----
# Player head size for embed icons (api.mcheads.org).
HEAD_SIZE=100
