# Standby logger: a second Minecraft account that stays in-game beside the
# primary and only writes when the primary stops.
#
# Copy the primary's env file, change MC_EMAIL to the backup account, and add
# the standby block at the bottom. Everything else — DATABASE_URL, MC_HOST,
# SERVER_KEY, EVENT_STREAM_ADDR — must stay identical to the primary's, because
# the point is that the two are interchangeable.
#
#   ENV_FILE=/path/to/.env.6b6t-backup ./target/release/azalea-bot
#   sudo systemctl enable --now azalea-bot-logger@.env.6b6t-backup

DATABASE_URL=postgres://sixbsixt:PASSWORD@localhost:5432/sixbsixt
MC_EMAIL=backup-account@example.com
MC_HOST=6b6t.org
MC_PORT=25565
MC_TARGET_VERSION=native
ENTER_PORTAL=true
ANTI_AFK=true

# Same key as the primary: Discord subscribes by server key, and a takeover
# must land on the same feed.
# EVENT_STREAM_ADDR=127.0.0.1:9700
# SERVER_KEY=6b6t

# --- standby ------------------------------------------------------------
# standby | backup | fallback all mean the same thing. Anything else (or unset)
# is a primary.
LOGGER_ROLE=standby

# Unique per process. Defaults to the env file's suffix, so `.env.6b6t-backup`
# already gives "6b6t-backup" — set it explicitly if you name files differently.
LOGGER_ID=6b6t-backup

# How stale a primary's heartbeat may get before the standby starts logging.
# Only matters when the primary process dies outright: an orderly disconnect
# reports connected=false and hands over on the next heartbeat instead.
STANDBY_TAKEOVER_SECS=45

# How often every logger writes its heartbeat row.
HEARTBEAT_SECS=15
