# 2b2t queue probe — sits in queue, records position, leaves at 1 and rejoins
# so Discord can show the real queue length. Run on a home IP (laptop), not VPS.
#
# Needs its own Microsoft account (cannot share with the in-game 2b2t logger).
DATABASE_URL=postgres://constantiam:PASSWORD@YOUR_VPS_IP:5432/twobtwot
MC_EMAIL=you@example.com
MC_HOST=2b2t.org
MC_PORT=25565
MC_TARGET_VERSION=native
ENTER_PORTAL=false
ANTI_AFK=false
QUEUE_PROBE=true
QUEUE_LEAVE_AT=1
SERVER_KEY=twobtwot
